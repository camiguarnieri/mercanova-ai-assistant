# Copiar a .env y ajustar. El archivo .env no se versiona.

# Modelo de Ollama que usa el asistente. qwen2.5:3b es el que mejor elige las
# herramientas de los que probamos. llama3.1 respeta más el esquema, pero son 8B
# contra 3B: pide bastante más memoria y en CPU tarda varias veces más.
OLLAMA_MODEL=qwen2.5:3b

# Host donde escucha Ollama.
OLLAMA_HOST=http://localhost:11434

# Ventana de contexto en tokens con la que se carga el modelo. El prompt del
# sistema más los esquemas de las herramientas ocupan unos 2800, así que con
# 4096 queda poco lugar para la conversación y Ollama empieza a truncar.
# Bajalo en máquinas con poca memoria: cuanto más grande, más RAM usa el modelo.
OLLAMA_NUM_CTX=8192

# Opcional, y sin valor por defecto: dejala vacía salvo que sepas que la
# necesitás. Es cuántos tokens como máximo escribe el modelo en una respuesta.
# En CPU cada token generado se paga en tiempo, así que bajarlo acorta la
# espera, pero probamos con 300 y cortó una respuesta a mitad de palabra: una
# respuesta truncada es peor que una lenta. Vacía, el tope lo decide Ollama.
OLLAMA_NUM_PREDICT=

# Cuánto tiempo Ollama deja el modelo cargado en memoria después de usarlo.
# Cargarlo cuesta unos segundos y se paga en el primer mensaje del usuario: en
# la corrida de siete turnos el turno 1 tardó 58.5s sin consultar nada. Acepta
# una duración ("30m", "1h"), segundos, o "-1" para que no lo descargue nunca.
# Bajalo en máquinas con poca memoria: el modelo la ocupa mientras está cargado.
OLLAMA_KEEP_ALIVE=30m

# Segundos que se espera CADA llamada al modelo antes de cortarla. La librería
# ollama no pone ninguno —su default es esperar para siempre—, así que sin esto
# un pedido del usuario se cuelga indefinidamente si el modelo no contesta.
# El default sale de la corrida de siete turnos en CPU que está en corrida.log:
# el turno más lento tardó 431.4s con una vuelta de herramientas, o sea dos
# llamadas de unos 215s cada una; 300s deja ~40% de margen sobre eso. Es por
# llamada y no por turno: un turno puede encadenar varias.
# Subilo si tu máquina es más lenta o usás un modelo más grande que 3B.
OLLAMA_TIMEOUT=300

# Archivo SQLite con el catálogo cargado por scripts/load_dataset.py.
DATABASE_PATH=data/mercanova.db

# Orígenes que el backend habilita para CORS, separados por coma. Tiene que
# incluir el origen donde corre el frontend o el navegador bloquea los pedidos.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
